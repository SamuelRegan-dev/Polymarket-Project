# Copy to .env and fill in for your machine. Everything has a sane default
# except the CSV paths, which the backtest loader needs.
#
# Every value below is optional except the two CSV paths — polysignals/config.py
# holds working defaults for the rest. Setting them here matters for one reason
# beyond convenience: .env is gitignored, so any parameter that reveals the
# tuned strategy can live here rather than in tracked source. To publish the
# repo without publishing the parameters, replace the defaults in config.py
# with placeholders and put the real values in this file.

# ── Required: local CSV dumps of Polymarket OrderFilled events + metadata ─────
# Produced with https://github.com/warproxxx/poly_data
ORDERFILLED_CSV_PATH=C:\path\to\orderFilled_complete.csv
MARKETS_CSV_PATH=C:\path\to\markets.csv

# ── Storage / infrastructure ──────────────────────────────────────────────────
# DB_PATH=                    # defaults to <repo>/data/polymarket.duckdb
# POLYGON_RPC=                # any Polygon mainnet RPC; defaults to a public one
# CSV_CHUNK_SIZE=100000       # rows per pandas chunk (performance only)

# ── Signal parameters — these define the strategy ─────────────────────────────
# SIGNAL_WINDOW_HOURS=48
# FLAT_THRESHOLD_USD=1000
# TOP_PCT_THRESHOLD=0.10
# MIN_MARKET_VOLUME=1000

# ── Market universes ──────────────────────────────────────────────────────────
# JSON array or a plain comma-separated list; matched case-insensitively as
# substrings of the market question. A market matching more than one cohort is
# excluded from both — see polysignals/core/cohorts.py.
# COMMITTEE_KEYWORDS=["oscar","emmy","nobel"]
# SPORTS_KEYWORDS=["nba","nfl","super bowl"]
# DEFAULT_COHORT=committee

# ── Resolution thresholds ─────────────────────────────────────────────────────
# HEURISTIC_WIN_THRESHOLD=0.90   # price-convergence winner inference
# RESOLVED_PRICE_THRESHOLD=0.99  # Gamma/API "this outcome won" threshold

# ── Analysis buckets (JSON arrays of ascending upper bounds) ──────────────────
# Where the edge concentrates is itself a finding, so these are configurable.
# TIME_BUCKETS_HOURS=[1,6,24]
# SIZE_BUCKETS_USD=[10000,50000,100000]
# PRICE_BUCKETS=[0.60,0.70,0.80,0.90,0.95,0.99]
# SIGNIFICANCE_ALPHA=0.05
# MIN_RESOLVED_SAMPLE=20

# ── Counter-test ──────────────────────────────────────────────────────────────
# COMPARISON_REQUIRE_ONCHAIN=true  # exclude circular heuristic resolutions
# EQUIVALENCE_MARGIN=0.10          # how close counts as "the same" (proportion)
# POST_OUTCOME_PRICE_FLOOR=0.97    # contamination diagnostic threshold

# ── API-driven backtest ───────────────────────────────────────────────────────
# BACKTEST_START_CUTOFF=2022-01-01T00:00:00Z
# MAX_TRADE_OFFSET=2500
